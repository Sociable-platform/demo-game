# Copy to .env (optional for farming). Never commit a real Clan API key.
# Game sessions use random opaque tokens stored hashed in the database.

# Environment: "development" (default) or "production"
NODE_ENV=development

# API port (the Vite dev server runs on 5173 and proxies /api to this)
PORT=3001

# SQLite database file (created automatically, migrations run on startup)
DB_PATH=./backend/data/harvest.db

# Browser origins allowed to make state-changing requests (comma separated)
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Session lifetime in hours
SESSION_TTL_HOURS=168

# Development-only helpers: /api/dev/* routes and the demo-account buttons on the login screen.
# Ignored (forced off) when NODE_ENV=production.
ENABLE_DEV_ROUTES=true

# Production only: set COOKIE_SECURE=false to test the production build over plain http on your own machine.
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy so client IPs (rate limiting) are read correctly.
# TRUST_PROXY=false

# Optional Clan Platform bridge (backend only; never use a VITE_ prefix).
# Base URL without /api/v1/players/auth. Leave blank to disable Clan auth.
CLAN_PLATFORM_URL=
# Backend-only Social base URL for account deletion, without /api/v1/players/me.
# Required with Platform URL + key to delete accounts or reset existing demo accounts.
CLAN_SOCIAL_URL=http://localhost:8082
# Secret key for this game, issued by Platform. Store only on the game server.
CLAN_GAME_API_KEY=

# Public frontend settings, embedded by Vite at build time.
# GAME_ID must match the game associated with the backend API key.
VITE_GAME_ID=
VITE_PLATFORM_URL=http://localhost:8081
VITE_SOCIAL_URL=http://localhost:8082
VITE_REALTIME_URL=http://localhost:8083
# SDK container script loaded before the game module. Override for deployment.
VITE_CLAN_SDK_URL=http://127.0.0.1:18080/v1/clan-sdk.js
