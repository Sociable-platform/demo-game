{
  "name": "harvest-village-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Harvest Village online desktop game",
  "author": "Clan",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.clan.harvestvillage",
    "productName": "Harvest Village",
    "artifactName": "Harvest-Village-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
